	journal = {Library Hi Tech},
	language = {en},
	month = nov,
	number = {4},
	pages = {700--724},
	shorttitle = {The cultivation of scientific data specialists},
	title = {The cultivation of scientific data specialists: {Development} of {LIS} education oriented to e-science service requirements},
	url = {https://www.emerald.com/insight/content/doi/10.1108/LHT-06-2013-0070/full/html},
	urldate = {2025-01-07},
	volume = {31},
