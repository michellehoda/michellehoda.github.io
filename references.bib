@inproceedings{gould_mobilize_2018,
	abstract = {The Mobilize Project was funded by the U.S. National Science Foundation in 2011 to develop "computational thinking" in secondary math and science classrooms through the use of participatory sensing, a data collection paradigm. This evolved into creating a year-long course Introduction to Data Science, which prepares students to think critically and constructively with data of many types and forms using the statistical software R. This course is currently taught in roughly 50 classrooms in a large urban school district in which a majority of students are below poverty levels. This talk will provide an overview of this curriculum and discuss the successes and the on-going challenges to developing "computational thinking with data".},
	address = {Kyoto, Japan},
