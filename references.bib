@article{wilkerson_how_2025-1,
	abstract = {Educators are being encouraged to teach with ``big'' datasets that have more cases and attributes than are typically used in the classroom. When introduced carefully, these types of datasets can allow students to engage in complex and self-directed reasoning, develop data management and inquiry skills, and experience data analysis in a way that is more authentic to professional practice. However, ``big data'' is also often unwieldy. It can overwhelm students, overload their software tools, and interfere with planful analysis. How can we make such datasets manageable? This paper presents pedagogical strategies and technical methods for educators, educational designers, and young investigators to reduce the number of cases or attributes in a large dataset in ways that do not unduly compromise their analyses. We illustrate these strategies with interactive demonstrations in two freely-available open source tools: the Choosy plugin in CODAP, and a Python Jupyter notebook.},
	author = {Wilkerson, Michelle H. and Erickson, Tim and Lee, Hollylynne S. and Finzer, William},
	copyright = {{\copyright} 2025 Teaching Statistics Trust.},
	date-modified = {2026-05-02 15:56:17 -0700},
	doi = {10.1111/test.70022},
	file = {Full Text PDF:/Users/michellehoda/Zotero/storage/6Z7VVAAM/Wilkerson et al. - How to be ``Choosy'' Wrangling big datasets for the classroom.pdf:application/pdf;Snapshot:/Users/michellehoda/Zotero/storage/VHI7CX2S/test.html:text/html},
	issn = {1467-9639},
	journal = {Teaching Statistics},
	keywords = {data science education, data wrangling, educational datasets, teaching statistics},
	language = {en},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/test.70022},
	number = {1},
	pages = {76-96},
	shorttitle = {How to be ``{Choosy}''},
	title = {How to be ``{Choosy}'': {Wrangling} big datasets for the classroom},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/test.70022},
	urldate = {2025-11-21},
	volume = {48},
