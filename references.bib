@article{tanweer_academic_2024,
	abstract = {As a nascent field within the academy, the contours, attributes, and bounties of data science are still indeterminate and contested. We studied how participants in an initiative to establish data science at a large American research university defined data science and articulated their relationships to the field. We discuss two contrasting visions for data science among our research participants. One vision is a transdisciplinary view portraying data science as a phenomenon with transcendent, appropriative, and impositional qualities that sits apart from academic domains. Another view of data science---one that was far more prevalent among our research subjects---casts data science as grounded, relational, and adaptive, emerging from crosspollination of numerous academic domains. We argue that this latter formulation represents a more quotidian reality of data science and positions the field as an extradiscipline, defined as a field that exists to facilitate the exchange of knowledge, skills, tools, and methods from an indeterminate and fluctuating set of disciplinary perspectives while conserving the boundaries of those disciplines. We argue that the dueling transdisciplinary and extradisciplinary visions for data science have important implications for how the field will mature, and that the extradiscipline concept opens novel directions for studying academic knowledge production in STS, contributing additional precision to the literature on disciplinarity and its permutations.},
	author = {Tanweer, Anissa and Steinhoff, James},
	doi = {10.1177/03063127231184443},
	file = {SAGE PDF Full Text:/Users/michellehoda/Zotero/storage/GYE3KH4Y/Tanweer and Steinhoff - 2024 - Academic data science Transdisciplinary and extradisciplinary visions.pdf:application/pdf},
	issn = {0306-3127},
	journal = {Social Studies of Science},
	language = {EN},
	month = feb,
	note = {Publisher: SAGE Publications Ltd},
	number = {1},
	pages = {133--160},
	shorttitle = {Academic data science},
	title = {Academic data science: {Transdisciplinary} and extradisciplinary visions},
	url = {https://doi.org/10.1177/03063127231184443},
	urldate = {2025-06-13},
	volume = {54},
	year = {2024},
	bdsk-url-1 = {https://doi.org/10.1177/03063127231184443}}

