@article{wilkerson_how_2026,
	title = {How to be “{Choosy}”: {Wrangling} big datasets for the classroom},
	volume = {48},
	copyright = {© 2025 Teaching Statistics Trust.},
	issn = {1467-9639},
	shorttitle = {How to be “{Choosy}”},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/test.70022},
	doi = {10.1111/test.70022},
	abstract = {Educators are being encouraged to teach with “big” datasets that have more cases and attributes than are typically used in the classroom. When introduced carefully, these types of datasets can allow students to engage in complex and self-directed reasoning, develop data management and inquiry skills, and experience data analysis in a way that is more authentic to professional practice. However, “big data” is also often unwieldy. It can overwhelm students, overload their software tools, and interfere with planful analysis. How can we make such datasets manageable? This paper presents pedagogical strategies and technical methods for educators, educational designers, and young investigators to reduce the number of cases or attributes in a large dataset in ways that do not unduly compromise their analyses. We illustrate these strategies with interactive demonstrations in two freely-available open source tools: the Choosy plugin in CODAP, and a Python Jupyter notebook.},
	language = {en},
	number = {1},
	urldate = {2025-11-21},
	journal = {Teaching Statistics},
	author = {Wilkerson, Michelle H. and Erickson, Tim and Lee, Hollylynne S. and Finzer, William},
	year = {2026},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/test.70022},
	keywords = {data science education, data wrangling, educational datasets, teaching statistics},
	pages = {76--96},
	file = {Full Text PDF:/Users/michellehoda/Zotero/storage/6Z7VVAAM/Wilkerson et al. - How to be “Choosy” Wrangling big datasets for the classroom.pdf:application/pdf;Snapshot:/Users/michellehoda/Zotero/storage/VHI7CX2S/test.html:text/html},
}

@incollection{fuhrmann_modality_2026,
	address = {Cham},
	title = {Modality {Matters}: {Exploring} and {Capturing} {Students}’ {Mechanistic} {Reasoning} {During} {Computational} {Modeling} in {Science} {Education}},
	isbn = {978-3-032-10246-1},
	shorttitle = {Modality {Matters}},
	url = {https://doi.org/10.1007/978-3-032-10246-1_11},
	doi = {10.1007/978-3-032-10246-1_11},
	abstract = {Computational modeling has been shown to support mechanistic reasoning in science education. Many studies use non-computational modalities, such as written responses and utterances, to capture and make claims about students’ mechanistic reasoning during computational modeling units. However, unlike computational models, these modalities of expression are less strictly aligned with the details of mechanistic reasoning (MR) and, therefore, may not accurately reflect students’ full reasoning. Understanding how students express their mechanistic reasoning across modalities is important for researchers to gain fuller insights into students’ developing MR. In this chapter, we inspect five elements of mechanistic reasoning to examine how they are expressed throughout a 6th-grade computational modeling science unit and how these expressions shift over the course of the lesson and across different modalities of student work (e.g., utterances, drawings, written responses). Certain aspects of MR, such as describing the organization or properties of system entities, were more difficult than others across modalities. While students’ MR develops over the course of the unit, as expected, many offered fuller expressions of MR during a verbal presentation of their code rather than on a written post-test at the end of the unit.},
	language = {en},
	urldate = {2026-03-10},
	booktitle = {Exploring {Mechanistic} {Reasoning} in {Science} {Education}: {Understanding} {Phenomena}},
	publisher = {Springer Nature Switzerland},
	author = {Fuhrmann, Tamar and Rosenbaum, Leah F. and Wagh, Aditi and Eloy, Adelmo and Blikstein, Paulo and Wilkerson, Michelle H.},
	editor = {Graulich, Nicole and Haskel Ittah, Michal and Wahyu Bachtiar, Rayendra},
	year = {2026},
	keywords = {Agent-based modeling, Computational modeling, K-12, Mechanistic reasoning},
	pages = {197--219},
	file = {Full Text PDF:/Users/michellehoda/Zotero/storage/J2ZQEES3/Fuhrmann et al. - 2026 - Modality Matters Exploring and Capturing Students’ Mechanistic Reasoning During Computational Model.pdf:application/pdf},
}

