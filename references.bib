	journal = {Journal of Statistics and Data Science Education},
	keywords = {Education, Case studies, Data ethics, Undergraduate curriculum},
	month = jan,
	note = {Publisher: Taylor \& Francis \_eprint: https://doi.org/10.1080/26939169.2022.2038041},
	number = {1},
	pages = {15--28},
	shorttitle = {Integrating {Data} {Science} {Ethics} {Into} an {Undergraduate} {Major}},
	title = {Integrating {Data} {Science} {Ethics} {Into} an {Undergraduate} {Major}: {A} {Case} {Study}},
