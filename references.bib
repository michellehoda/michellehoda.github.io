	keywords = {justice-centered science pedagogy, Climate change, geospatial learning},
	month = may,
	note = {Publisher: Routledge \_eprint: https://doi.org/10.1080/24758779.2024.2349940},
	number = {3},
	pages = {133--140},
	title = {Creating a {Family} of {Educators} {Committed} to {Justice}-{Centered} {Climate} {Change} {Pedagogy}},
	url = {https://doi.org/10.1080/24758779.2024.2349940},
