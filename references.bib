	file = {Dryer et al. - 2018 - A Middle-School Module for Introducing Data-Mining.pdf:/Users/michellehoda/Zotero/storage/WEKISVKV/Dryer et al. - 2018 - A Middle-School Module for Introducing Data-Mining.pdf:application/pdf;Dryer et al. - 2018 - A Middle-School Module for Introducing Data-Mining.pdf:/Users/michellehoda/Zotero/storage/9REZADY3/Dryer et al. - 2018 - A Middle-School Module for Introducing Data-Mining.pdf:application/pdf},
