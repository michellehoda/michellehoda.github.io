	file = {Full Text PDF:/Users/michellehoda/Zotero/storage/D9TCML95/Biehler et al. - 2013 - Technology for Enhancing Statistical Reasoning at the School Level.pdf:application/pdf},
	isbn = {978-1-4614-4684-2},
	keywords = {Exploratory Data Analysis, Statistical Concept, Statistical Inference, Statistical Reasoning, Technological Tool},
	language = {en},
	pages = {643--689},
	publisher = {Springer},
	title = {Technology for {Enhancing} {Statistical} {Reasoning} at the {School} {Level}},
